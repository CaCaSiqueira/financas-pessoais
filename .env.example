# Copie para .env.local e preencha. Nunca commite .env.local.

# Supabase (Project Settings → API Keys). A chave publishable é pública e protegida por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública do app (usada nos redirects de auth). Em produção: o domínio da Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente local / CLI — nunca expor no cliente nem cadastrar na Vercel.
# Senha do Postgres, usada por `supabase link` e `supabase db push`.
SUPABASE_DB_PASSWORD=
