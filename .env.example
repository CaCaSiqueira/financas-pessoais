# Copie para .env.local e preencha. Nunca commite .env.local.

# Supabase (Project Settings → API). A chave anon/publishable é pública e protegida por RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app (usada em redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
